# --- Local Postgres (Docker) ---
POSTGRES_USER=opendata
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opendata
POSTGRES_PORT=54329
READER_PASSWORD=change-me-too
STORE_PASSWORD=change-me-three

# Loader writes with the owner role; the app only reads with dashboard_reader.
# On Vercel, set DATABASE_URL to your hosted Postgres (e.g. Neon) instead.
DATABASE_URL_ADMIN=postgres://opendata:change-me@localhost:54329/opendata
DATABASE_URL=postgres://dashboard_reader:change-me-too@localhost:54329/opendata
# Saved dashboards are written with a role that can touch only the dashboards table.
DATABASE_URL_STORE=postgres://dashboard_store:change-me-three@localhost:54329/opendata

# --- LLM via OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# A model id from https://openrouter.ai/models. Default: anthropic/claude-haiku-5.5 (paid, about $0.004 per dashboard)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

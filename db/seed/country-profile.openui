$country = "IND"
$start = "2000"
root = Stack([filters, kpis, gdpCard, netCard, rankCard, tableCard])
filters = Stack([countrySel, startSel], "row", "m", "end")
countrySel = Select("country", [SelectItem("IND", "India"), SelectItem("CHN", "China"), SelectItem("BGD", "Bangladesh"), SelectItem("PAK", "Pakistan"), SelectItem("IDN", "Indonesia"), SelectItem("BRA", "Brazil"), SelectItem("USA", "United States"), SelectItem("WLD", "World")], "Country", null, $country)
startSel = Select("start", [SelectItem("1980", "Since 1980"), SelectItem("1990", "Since 1990"), SelectItem("2000", "Since 2000"), SelectItem("2010", "Since 2010"), SelectItem("2015", "Since 2015")], "From year", null, $start)
gdp = Query("get_series", {indicator: "NY.GDP.PCAP.CD", country: $country, startYear: $start}, {countryName: "", labels: [], values: [], latestValue: 0, latestYear: "", firstValue: 0, firstYear: "", changePct: 0})
net = Query("get_series", {indicator: "IT.NET.USER.ZS", country: $country, startYear: $start}, {countryName: "", labels: [], values: [], latestValue: 0, latestYear: "", firstValue: 0, firstYear: "", changePct: 0})
life = Query("get_series", {indicator: "SP.DYN.LE00.IN", country: $country, startYear: $start}, {countryName: "", labels: [], values: [], latestValue: 0, latestYear: "", firstValue: 0, firstYear: "", changePct: 0})
rank = Query("get_comparison", {indicator: "NY.GDP.PCAP.CD"}, {rows: []})
snap = Query("get_snapshot", {country: $country}, {countryName: "", rows: []})
kpis = SnippetCardBlock([kGdp, kNet, kLife], "grid", true)
kGdp = SnippetCardItem("gdp", IconText(Icon("circle-dollar-sign", "finance"), "neutral", "m", "GDP per capita", gdp.latestYear + ", current US$", false, "horizontal"), BoldText("number", "$" + @Round(gdp.latestValue, 0), "+" + @Round(gdp.changePct, 0) + "% since " + gdp.firstYear, "metric"))
kNet = SnippetCardItem("net", IconText(Icon("globe", "technology"), "neutral", "m", "Internet users", net.latestYear + ", % of population", false, "horizontal"), BoldText("number", @Round(net.latestValue, 1) + "%", "up from " + @Round(net.firstValue, 1) + "% in " + net.firstYear, "text"))
kLife = SnippetCardItem("life", IconText(Icon("heart-pulse", "health"), "neutral", "m", "Life expectancy", life.latestYear + ", years", false, "horizontal"), BoldText("number", "" + @Round(life.latestValue, 1), "up from " + @Round(life.firstValue, 1) + " in " + life.firstYear, "text"))
gdpCard = Card([CardHeader("GDP per capita", gdp.countryName + ", current US$"), LineChart(gdp.labels, [Series(gdp.countryName, gdp.values)], "linear", "Year", "US$")])
netCard = Card([CardHeader("Individuals using the internet", net.countryName + ", % of population"), LineChart(net.labels, [Series(net.countryName, net.values)], "linear", "Year", "% of population")])
rankCard = Card([CardHeader("GDP per capita, all countries", "Latest available year, current US$"), BarChart(rank.rows.countryName, [Series("GDP per capita", rank.rows.value)])])
tableCard = Card([CardHeader("Latest indicators", snap.countryName + ", with the change over 10 years"), Table([Col("Indicator", snap.rows.name), Col("Year", snap.rows.year), Col("Value", snap.rows.value, "number"), Col("10 years earlier", snap.rows.value10yEarlier, "number"), Col("Change %", snap.rows.changePct, "number")])])

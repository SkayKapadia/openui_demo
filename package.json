{
  "name": "india-open-data-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "openui generate src/library.ts --spec --out src/generated/spec.json",
    "predev": "npm run generate",
    "dev": "next dev",
    "prebuild": "npm run generate",
    "build": "next build",
    "preverify": "npm run generate",
    "verify": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:schema": "node --env-file=.env scripts/apply-schema.mts",
    "load:worldbank": "node --env-file=.env scripts/load-worldbank.mts",
    "db:seed": "node --env-file=.env scripts/seed-dashboards.mts",
    "validate": "node scripts/validate-openui.mts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@openuidev/lang-core": "1.1.1",
    "@openuidev/react-headless": "0.18.8",
    "@openuidev/react-lang": "1.1.1",
    "@openuidev/react-ui": "0.18.7",
    "ai": "^6.0.116",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@openuidev/cli": "0.6.3",
    "@types/node": "^22.15.32",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5"
  },
  "allowScripts": {
    "@openuidev/lang-core": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
